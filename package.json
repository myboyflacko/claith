{
  "name": "claith",
  "version": "0.1.0",
  "description": "Self-hosted agentic development environment that turns approved Delivery Contracts into evidence-backed software outcomes with minimal developer attention",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "format:files": "prettier --write",
    "format:check:files": "prettier --check",
    "lint:files": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@temporalio/testing": "1.24.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "smol-toml": "1.9.1",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  }
}
